# Copy to .env — used by apps/api and drizzle-kit
DATABASE_URL=postgres://home-bird:home-bird@localhost:5434/home-bird
PORT=3000
# Host port for the dockerized postgres (container always listens on 5432 internally)
POSTGRES_PORT=5434

# Where uploaded images (floor plans, references) are stored on disk,
# relative to the api process
IMAGE_STORAGE_DIR=./.data/images

# Allowed CORS origin for the api (defaults to the web dev server)
CORS_ORIGIN=http://localhost:5173
